{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly", ":enableVulnerabilityAlerts"],
  "assignees": ["hu553in"],
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group non-major dependency updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Group Bun runtime updates",
      "matchPackageNames": ["@types/bun", "bun", "oven/bun"],
      "groupName": "Bun runtime"
    },
    {
      "description": "Group Go runtime updates",
      "matchManagers": ["custom.regex", "dockerfile", "gomod"],
      "matchPackageNames": ["go", "golang"],
      "groupName": "Go runtime"
    },
    {
      "description": "Group Java runtime updates",
      "matchPackageNames": ["eclipse-temurin", "java", "java-jdk"],
      "groupName": "Java runtime"
    },
    {
      "description": "Group Python runtime updates",
      "matchManagers": ["custom.regex", "dockerfile", "pep621"],
      "matchPackageNames": ["ghcr.io/astral-sh/uv", "python"],
      "groupName": "Python runtime"
    },
    {
      "description": "Preserve floating major tags for GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchCurrentValue": "/^v\\d+$/",
      "allowedVersions": "/^v\\d+$/"
    }
  ]
}
