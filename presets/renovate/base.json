{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly", ":enableVulnerabilityAlerts"],
  "assignees": ["hu553in"],
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group non-major dependency updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Preserve floating major tags for GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchCurrentValue": "/^v\\d+$/",
      "allowedVersions": "/^v\\d+$/"
    }
  ]
}
