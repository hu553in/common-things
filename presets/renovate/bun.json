{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hu553in/common-things//presets/renovate/base"],
  "enabledManagers": ["bun", "custom.regex", "docker-compose", "dockerfile", "github-actions"],
  "packageRules": [
    {
      "description": "Disable automatic Node.js major updates",
      "matchManagers": ["bun"],
      "matchPackageNames": ["node"],
      "matchDepTypes": ["engines"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
