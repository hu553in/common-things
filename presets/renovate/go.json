{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hu553in/common-things//presets/renovate/base",
    "security:gomodIndirectSecurityUpdates"
  ],
  "enabledManagers": ["docker-compose", "dockerfile", "github-actions", "gomod"],
  "packageRules": [
    {
      "description": "Run go mod tidy after Go module updates",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Group Go runtime updates",
      "matchManagers": ["dockerfile", "gomod"],
      "matchPackageNames": ["go", "golang"],
      "groupName": "Go runtime"
    },
    {
      "description": "Bump Go version in go.mod",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ]
}
