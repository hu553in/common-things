{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hu553in/common-things//presets/renovate/base"],
  "ignorePresets": ["workarounds:javaLTSVersions"],
  "enabledManagers": [
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gradle",
    "gradle-wrapper"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track annotated Spring dependency version overrides",
      "managerFilePatterns": ["/(^|/)gradle\\.properties$/"],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)[ \\t]*# renovate: datasource=maven depName=(?<depName>[^\\s]+)[ \\t]*(?:\\r\\n|\\r|\\n)[ \\t]*[\\w.]+[ \\t]*=[ \\t]*(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Track annotated Docker buildpacks in Gradle",
      "managerFilePatterns": ["/(^|/)build\\.gradle\\.kts$/"],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)[ \\t]*// renovate: datasource=docker[ \\t]*(?:\\r\\n|\\r|\\n)[ \\t]*\"(?<depName>[^\"\\s]+):(?<currentValue>[^\"\\s:]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track Java runtime in Gradle and CI",
      "managerFilePatterns": [
        "/(^|/)build\\.gradle\\.kts$/",
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)[ \\t]*jvmToolchain[ \\t]*\\([ \\t]*(?<currentValue>\\d+)[ \\t]*\\)",
        "(?:^|\\r\\n|\\r|\\n)[ \\t]*java[_-]version:[ \\t]*['\"](?<currentValue>\\d+)['\"]"
      ],
      "datasourceTemplate": "java-version",
      "depNameTemplate": "java",
      "extractVersionTemplate": "^(?<version>\\d+)",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group Java runtime updates",
      "matchPackageNames": ["java", "eclipse-temurin"],
      "groupName": "Java runtime"
    }
  ]
}
