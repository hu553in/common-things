{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hu553in/common-things//presets/renovate/base"],
  "ignorePresets": ["workarounds:javaLTSVersions"],
  "enabledManagers": [
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gradle",
    "gradle-wrapper",
    "mise"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track annotated Spring dependency version overrides",
      "managerFilePatterns": ["/(^|/)gradle\\.properties$/"],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)[ \\t]*# renovate: datasource=maven depName=(?<depName>[^\\s]+)[ \\t]*(?:\\r\\n|\\r|\\n)[ \\t]*[\\w.-]+[ \\t]*=[ \\t]*(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Track annotated Docker buildpacks in Gradle",
      "managerFilePatterns": ["/(^|/)build\\.gradle\\.kts$/"],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)[ \\t]*// renovate: datasource=docker[ \\t]*(?:\\r\\n|\\r|\\n)[ \\t]*\"(?<depName>[^\"\\s]+):(?<currentValue>[^\"\\s:]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track Java runtime in Gradle and reusable workflows",
      "managerFilePatterns": [
        "/(^|/)build\\.gradle\\.kts$/",
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)[ \\t]*jvmToolchain[ \\t]*\\([ \\t]*(?<currentValue>\\d+)[ \\t]*\\)",
        "(?:^|\\r\\n|\\r|\\n)[ \\t]*java_version:[ \\t]*['\"](?<currentValue>\\d+)['\"]"
      ],
      "datasourceTemplate": "java-version",
      "depNameTemplate": "java",
      "extractVersionTemplate": "^(?<version>\\d+)",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Preserve partial Java versions and compatibility limits",
      "matchManagers": ["github-actions", "mise"],
      "matchDatasources": ["java-version"],
      "matchCurrentValue": "/^\\d+(?:\\.\\d+)?$/",
      "versioning": "npm"
    },
    {
      "description": "Wait until Maven releases are three days old when the registry reports a release date",
      "matchDatasources": ["maven"],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
