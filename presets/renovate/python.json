{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hu553in/common-things//presets/renovate/base",
    "security:minimumReleaseAgePypi"
  ],
  "enabledManagers": ["custom.regex", "docker-compose", "dockerfile", "github-actions", "pep621"],
  "packageRules": [
    {
      "description": "Bump Python dependency ranges",
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Preserve Python compatibility floor",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Parse Python runtime tags in uv images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/astral-sh/uv"],
      "matchCurrentValue": "/^python\\d+\\.\\d+-/",
      "versioning": "regex:^python(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>.+)$"
    }
  ]
}
