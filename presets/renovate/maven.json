{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hu553in/common-things//presets/renovate/base"],
  "ignorePresets": ["workarounds:javaLTSVersions"],
  "enabledManagers": [
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "maven",
    "maven-wrapper",
    "mise"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track annotated Maven dependency versions",
      "managerFilePatterns": ["/(^|/|\\.)pom\\.xml$/"],
      "matchStrings": [
        "<!-- renovate: datasource=maven depName=(?<depName>[^\\s]+)[ \\t]*-->\\s*<[\\w.-]+>(?<currentValue>[^<\\s]+)</[\\w.-]+>"
      ],
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Track Java runtime in reusable workflows",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)[ \\t]*java_version:[ \\t]*['\"](?<currentValue>\\d+)['\"]"
      ],
      "datasourceTemplate": "java-version",
      "depNameTemplate": "java",
      "extractVersionTemplate": "^(?<version>\\d+)",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Preserve partial Java versions and compatibility limits",
      "matchManagers": ["github-actions", "mise"],
      "matchDatasources": ["java-version"],
      "matchCurrentValue": "/^\\d+(?:\\.\\d+)?$/",
      "versioning": "npm"
    },
    {
      "description": "Wait until Maven releases are three days old when the registry reports a release date",
      "matchDatasources": ["maven"],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
